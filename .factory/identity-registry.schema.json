{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoworks.com/schemas/identity-registry.schema.json",
  "title": "Edoworks canonical identity registry",
  "type": "object",
  "required": ["schema_version", "authority", "legal_entity", "contacts", "address_policies", "identities", "trademarks", "domains"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"type": "object"},
    "legal_entity": {"type": "object"},
    "contacts": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "address_policies": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "identities": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "trademarks": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["entity_id", "provenance"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
