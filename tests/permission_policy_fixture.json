{
  "rules": [
    ["git status*", "allow"],
    ["git diff*", "allow"],
    ["git log*", "allow"],
    ["git show*", "allow"],
    ["git add *", "allow"],
    ["git commit -m *", "allow"],
    ["gh issue *", "deny"],
    ["gh pr *", "deny"],
    ["gh pr create --repo edoworks/nownest *", "allow"],
    ["gh pr view * --repo edoworks/nownest *", "allow"],
    ["gh pr checks * --repo edoworks/nownest *", "allow"],
    ["gh pr ready * --repo edoworks/nownest", "allow"],
    ["gh pr view * --repo edoworks/artifacts *", "allow"],
    ["gh pr checks * --repo edoworks/artifacts *", "allow"],
    ["gh pr create --repo edoworks/artifacts *", "ask"],
    ["gh pr edit * --repo edoworks/artifacts *", "allow"],
    ["gh pr review * --repo edoworks/artifacts *", "allow"],
    ["gh pr close * --repo edoworks/artifacts *", "ask"],
    ["gh pr view * --repo edoworks/sf0.8 *", "allow"],
    ["gh pr checks * --repo edoworks/sf0.8 *", "allow"],
    ["gh pr create --repo edoworks/sf0.8 *", "allow"],
    ["gh pr edit * --repo edoworks/sf0.8 *", "allow"],
    ["gh pr create --repo edoworks/edoworks.github.io *", "allow"],
    ["gh pr view * --repo edoworks/edoworks.github.io *", "allow"],
    ["gh pr checks * --repo edoworks/edoworks.github.io *", "allow"],
    ["gh pr edit * --repo edoworks/edoworks.github.io *", "allow"],
    ["gh pr create --repo foculoom/foculoom.github.io *", "allow"],
    ["gh pr view * --repo foculoom/foculoom.github.io *", "allow"],
    ["gh pr checks * --repo foculoom/foculoom.github.io *", "allow"],
    ["gh pr edit * --repo foculoom/foculoom.github.io *", "allow"],
    ["gh pr review * --repo foculoom/foculoom.github.io *", "allow"],
    ["gh pr view * --repo edoworks/factory *", "allow"],
    ["gh pr checks * --repo edoworks/factory *", "allow"],
    ["gh pr create --repo edoworks/factory *", "allow"],
    ["gh pr edit * --repo edoworks/factory *", "allow"],
    ["gh pr merge * --repo edoworks/* *", "allow"],
    ["gh pr merge --repo edoworks/* *", "allow"],
    ["gh pr merge * --repo foculoom/* *", "allow"],
    ["gh pr merge --repo foculoom/* *", "allow"],
    ["gh pr merge*--admin*", "deny"],
    ["gh repo *", "deny"],
    ["gh api *", "deny"],
    ["gh api user --jq .login", "allow"],
    ["gh issue view --repo edoworks/sf0.8 *", "allow"],
    ["gh issue list --repo edoworks/sf0.8 *", "allow"],
    ["gh issue status --repo edoworks/sf0.8", "allow"],
    ["gh issue status --repo edoworks/sf0.8 *", "allow"],
    ["gh issue create --repo edoworks/sf0.8 *", "ask"],
    ["gh issue comment --repo edoworks/sf0.8 *", "ask"],
    ["gh issue close --repo edoworks/sf0.8 *", "ask"],
    ["gh issue view --repo edoworks/factory *", "allow"],
    ["gh issue list --repo edoworks/factory *", "allow"],
    ["gh issue status --repo edoworks/factory", "allow"],
    ["gh issue status --repo edoworks/factory *", "allow"],
    ["gh issue create --repo edoworks/factory *", "allow"],
    ["gh issue comment --repo edoworks/factory *", "ask"],
    ["gh issue close --repo edoworks/factory *", "ask"],
    ["gh issue view --repo edoworks/product-a *", "allow"],
    ["gh issue list --repo edoworks/product-a *", "allow"],
    ["gh issue view --repo edoworks/sf0.7 *", "allow"],
    ["gh issue list --repo edoworks/sf0.7 *", "allow"],
    ["gh issue view --repo edoworks/sf0.5 *", "allow"],
    ["gh issue list --repo edoworks/sf0.5 *", "allow"],
    ["gh release create * --repo edoworks/factory *", "allow"],
    ["gh label * --repo edoworks/factory *", "allow"],
    ["gh label create * --repo edoworks/factory *", "allow"],
    ["gh label list --repo edoworks/factory *", "allow"],
    ["gh label list --repo edoworks/factory", "allow"],
    ["git commit*--no-verify*", "deny"],
    ["git commit*-n*", "deny"],
    ["git reset --hard*", "deny"],
    ["git clean -f*", "deny"],
    ["git rebase -i*", "deny"],
    ["git push*", "ask"],
    ["git tag*", "ask"],
    ["git commit*--amend*", "ask"],
    ["git push*--force*", "deny"],
    ["git push*--mirror*", "deny"],
    ["git push*-f*", "deny"],
    ["git push*+*", "deny"],
    ["git push*--delete*", "ask"],
    ["git -c credential.helper= -c credential.helper=*gh auth git-credential* push --no-follow-tags origin HEAD:refs/heads/feature/*", "allow"],
    ["git add .", "ask"],
    ["git add -A*", "ask"],
    ["git add --all*", "ask"],
    ["git add -u*", "ask"],
    ["git add --update*", "ask"],
    ["git add --pathspec-from-file*", "ask"],
    ["git add -*", "ask"],
    ["git add --*", "ask"],
    ["*;*", "deny"],
    ["*&&*", "deny"],
    ["*||*", "deny"],
    ["*|*", "deny"],
    ["*\n*", "deny"]
  ],
  "expectations": {
    "allow": [
      "git status --short",
      "git diff --check",
      "git add ProductA/ListenView.swift",
      "git commit -m \"test policy\"",
      "gh api user --jq .login",
      "gh issue view --repo edoworks/sf0.8 54",
      "gh issue list --repo edoworks/sf0.8 --state open",
      "gh issue status --repo edoworks/sf0.8",
      "gh issue view --repo edoworks/factory 1",
      "gh issue list --repo edoworks/factory --state all",
      "gh issue status --repo edoworks/factory",
      "gh issue create --repo edoworks/factory --title test --body-file issue.md",
      "gh issue view --repo edoworks/product-a 1",
      "gh issue list --repo edoworks/product-a --state open",
      "gh issue view --repo edoworks/sf0.7 1",
      "gh issue list --repo edoworks/sf0.7 --state open",
      "gh issue view --repo edoworks/sf0.5 1",
      "gh issue list --repo edoworks/sf0.5 --state open",
      "gh release create v0.1.0-rc3 --repo edoworks/factory --prerelease --title test --notes-file notes.md",
      "gh label create test --repo edoworks/factory --color f0f0f0",
      "gh label list --repo edoworks/factory",
      "gh pr create --repo edoworks/sf0.8 --base main --head feature/test --title test --body-file pr.md",
      "gh pr create --repo edoworks/nownest --base main --head feature/test --title test --body-file pr.md",
      "gh pr view 1 --repo edoworks/nownest --json state",
      "gh pr checks 1 --repo edoworks/nownest --watch",
      "gh pr ready 1 --repo edoworks/nownest",
      "gh pr edit 80 --repo edoworks/sf0.8 --body-file pr.md",
      "gh pr merge 80 --repo edoworks/sf0.8 --merge",
      "gh pr merge --repo edoworks/sf0.8 80 --merge",
      "gh pr merge --repo edoworks/product-a 80 --merge --delete-branch",
      "gh pr merge 80 --repo foculoom/vorynce --squash --delete-branch",
      "gh pr merge --repo foculoom/vorynce 80 --merge",
      "gh pr review 1 --repo edoworks/artifacts --approve",
      "gh pr review 184 --repo foculoom/foculoom.github.io --approve",
      "git -c credential.helper= -c credential.helper='!gh auth git-credential' push --no-follow-tags origin HEAD:refs/heads/feature/test"
    ],
    "ask": [
      "gh issue create --repo edoworks/sf0.8 --title test --body-file evidence.md",
      "gh issue comment --repo edoworks/sf0.8 52 --body-file evidence.md",
      "gh issue comment --repo edoworks/sf0.8 999999 --body evidence",
      "gh issue close --repo edoworks/sf0.8 53",
      "gh issue close --repo edoworks/sf0.8 999999",
      "gh issue comment --repo edoworks/factory 1 --body-file comment.md",
      "gh issue close --repo edoworks/factory 1",
      "gh pr create --repo edoworks/artifacts --base main --head feature/test --title test --body-file pr.md",
      "git add .",
      "git add -A",
      "git commit --amend",
      "git push origin main",
      "git push --delete origin feature",
      "git tag v1.0.0"
    ],
    "deny": [
      "git commit -m \"bypass\" --no-verify",
      "git commit -m \"bypass\" -n",
      "git reset --hard HEAD",
      "git clean -fd",
      "git push --force origin main",
      "git push -f origin main",
      "git push --mirror origin",
      "git status; git push --force origin main",
      "git diff && git push origin main",
      "git log | sh",
      "gh issue close 52 --repo edoworks/sf0.8",
      "gh issue close --repo other/repo 52",
      "gh issue status --repo edoworks/sf0.8-malicious",
      "gh issue close --repo edoworks/sf0.8-malicious 52",
      "gh issue close 52",
      "gh issue comment 52 --repo edoworks/sf0.8 --body unrelated",
      "gh issue comment --repo other/repo 52 --body unrelated",
      "gh issue create --repo edoworks/sf0.8 --title test --body inline;separator",
      "gh issue close --repo edoworks/sf0.8 52 && gh issue close --repo edoworks/sf0.8 53",
      "gh api --method PATCH repos/edoworks/sf0.8/issues/52 -f state=closed",
      "gh pr create --repo other/repo --title unrelated",
      "gh pr merge --repo other/repo 80 --merge",
      "gh pr merge --repo edoworks-malicious/repo 80 --merge",
      "gh pr merge --repo foculoom-malicious/repo 80 --merge",
      "gh pr merge --repo edoworks/sf0.8 80 --merge --admin",
      "gh pr merge 80 --repo foculoom/vorynce --squash --admin",
      "gh pr review 184 --repo other/repo --approve",
      "gh pr review 184 --repo foculoom-malicious/foculoom.github.io --approve",
      "gh repo edit edoworks/sf0.8 --visibility public"
    ]
  }
}
